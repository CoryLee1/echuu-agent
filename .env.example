# ============================================
# echuu-agent 环境配置模板
# 复制此文件为 .env 并填入你的配置
# ============================================

# LLM API 配置 (选择一个)
# --------------------------------------------

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 通义千问 TTS 配置 (阿里云百炼)
# 获取 API Key: https://bailian.console.aliyun.com/?tab=model#/api-key
# 注意: 中国大陆和国际版 API Key 不同
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# TTS 模型 (使用 qwen3-tts-flash-realtime 支持多语言)
# 可选模型:
#   - qwen3-tts-flash-realtime (推荐, 稳定版)
#   - qwen3-tts-instruct-flash-realtime (支持指令控制)
#   - qwen-tts-realtime (上一代)
TTS_MODEL=qwen3-tts-flash-realtime

# TTS 音色 (支持多语言: 中文/英文/日文/韩文/法文/德文/俄文/意大利语/西班牙语/葡萄牙语)
# 女生: Cherry(阳光积极), Serena(温柔), Chelsie(二次元), Momo(撒娇), Kiki(粤语甜妹)
# 男生: Ethan(阳光温暖), Ryan(戏感炸裂), Jennifer(美式英语)
# 更多音色: https://help.aliyun.com/zh/model-studio/qwen-tts-realtime
TTS_VOICE=Cherry

# Realtime 参数
TTS_MODE=server_commit
TTS_LANGUAGE_TYPE=Chinese
TTS_RESPONSE_FORMAT=pcm
TTS_SAMPLE_RATE=24000
TTS_SPEECH_RATE=1.0
TTS_VOLUME=50
TTS_PITCH_RATE=1.0
TTS_BIT_RATE=128
TTS_TIMEOUT=60

# 区域设置: cn=中国北京, sg/intl=新加坡/国际
# 注意: API Key 必须与区域匹配
TTS_REGION=cn
# TTS_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime (中国北京)
# TTS_WS_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime (新加坡/国际)

# OpenAI API (可选)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# 通义千问 API (可选)
# DASHSCOPE_API_KEY=your-dashscope-api-key-here

# Google Gemini 3 API (推荐 - 最新 AI 模型)
# 获取 API Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-gemini-api-key-here

# Gemini 3 模型选择 (默认使用 Flash 平衡性能)
# gemini-3-flash-preview    - 快速、高智能、性价比高 (推荐)
# gemini-3-pro-preview      - 最强推理能力，适合复杂任务
# gemini-3-pro-image-preview - 高质量图像生成
# gemini-2.0-flash          - 上一代 Flash 模型
GEMINI_MODEL=gemini-3-flash-preview

# Gemini 3 思考级别 (可选，控制推理深度)
# high   - 最大推理深度 (默认，适合复杂任务)
# low    - 最小延迟 (适合简单对话)
# medium - 平衡 (仅 Flash)
# minimal - 最快 (仅 Flash)
# GEMINI_THINKING_LEVEL=high

# 默认模型配置
# --------------------------------------------
DEFAULT_MODEL=claude-sonnet-4-20250514
# DEFAULT_MODEL=gpt-4o
# DEFAULT_MODEL=qwen-max
# DEFAULT_MODEL=gemini-3-flash-preview

# 三模式配置（storytelling / reaction / singing_learn）
# --------------------------------------------
# LLM 大脑（DASHSCOPE_API_KEY 存在时自动选 Qwen，可用 QWEN_MODEL 换档）
# QWEN_MODEL=qwen-plus          # 默认；便宜档可换 qwen-flash
# QWEN_REGION=cn                # cn=北京, sg/intl=新加坡

# Reaction 模式：视频理解模型
# REACTION_OMNI_MODEL=qwen3.5-omni-plus   # 短视频省钱可换 qwen3-omni-flash（≤150s）

# 学唱模式：Replicate 托管管线（全 API，零自部署）
# REPLICATE_API_TOKEN=r8_xxx    # https://replicate.com/account/api-tokens
# RVC_MODEL_URL=                # 角色 RVC 音色模型 zip 的下载 URL（train-rvc-model 产物）
#                               # 未配置时演唱保留原唱声线，管线照常可跑
# RVC_PITCH_CHANGE=no-change    # 男歌→女角色声线时可设 female-to-male 的反向档

# 数据路径配置
# --------------------------------------------
RAW_DATA_PATH=data/vtuber_raw_clips_for_notebook_full_30_cleaned.jsonl
ANNOTATED_DATA_PATH=data/annotated_clips.json

# 标注配置
# --------------------------------------------
# 最大并发请求数
MAX_CONCURRENT_REQUESTS=3
# 每个请求之间的延迟（秒）
REQUEST_DELAY=1.0
# 是否启用详细日志
VERBOSE=true
