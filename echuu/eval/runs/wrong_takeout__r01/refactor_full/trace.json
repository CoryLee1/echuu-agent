          ],
          "acoustic": {
            "pitch_rate": 0.88,
            "speech_rate": 0.88,
            "volume": 48
          },
          "axis": null,
          "density": "low",
          "rupture_slots": [],
          "lines": [
            {
              "id": "u2l0",
              "text": "最后他硬塞给我三瓶冰水，说‘你骑车热’，我接过来的时候，指尖还沾着他手心的汗。",
              "stage": "hook",
              "is_rupture": false,
              "interruption_cost": 0.5,
              "cue": null
            },
            {
              "id": "u2l1",
              "text": "转身下楼，左手已经摸到箱盖边沿了……掀开，扣上；再掀开，再扣上。",
              "stage": "pad",
              "is_rupture": false,
              "interruption_cost": 0.4,
              "cue": null
            },
            {
              "id": "u2l2",
              "text": "其实啊，成年人的体面，就是默契地不戳破——对方手在抖，你自己也在抖。",
              "stage": "turn",
              "is_rupture": false,
              "interruption_cost": 0.3,
              "cue": null
